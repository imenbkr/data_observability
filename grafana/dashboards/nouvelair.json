{
  "uid": "nouvelair",
  "title": "Nouvelair · Data Observability",
  "tags": [
    "data-observability",
    "kafka",
    "nouvelair"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Live · Nouvelair flights (real ADS-B data from adsb.lol)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "geomap",
      "title": "Nouvelair flights right now",
      "description": "Positions of every Nouvelair (LBT) aircraft tracked in the last 10 minutes. Colour = altitude.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 14,
        "w": 15,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8AB8FF",
                "value": null
              },
              {
                "color": "#5794F2",
                "value": 10000
              },
              {
                "color": "#1F60C4",
                "value": 25000
              },
              {
                "color": "#FF9830",
                "value": 33000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "refId": "A",
          "expr": "nouvelair_flight_latitude",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "refId": "B",
          "expr": "nouvelair_flight_longitude",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "refId": "C",
          "expr": "nouvelair_flight_altitude_feet",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "refId": "D",
          "expr": "nouvelair_flight_ground_speed_knots",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "refId": "E",
          "expr": "nouvelair_flight_track_degrees",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 42.5,
          "lon": 8,
          "zoom": 4.2
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap",
          "config": {}
        },
        "layers": [
          {
            "type": "markers",
            "name": "Flights",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": false,
              "style": {
                "size": {
                  "fixed": 14
                },
                "color": {
                  "field": "altitude_ft",
                  "fixed": "dark-green"
                },
                "opacity": 0.9,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/plane.svg"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "rotation": {
                  "field": "track",
                  "fixed": 0,
                  "min": -360,
                  "max": 360,
                  "mode": "mod"
                },
                "text": {
                  "mode": "field",
                  "field": "callsign",
                  "fixed": ""
                },
                "textConfig": {
                  "fontSize": 10,
                  "offsetX": 0,
                  "offsetY": -14,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "callsign": 0,
              "route": 1,
              "aircraft_type": 2,
              "registration": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #A": 6,
              "Value #B": 7,
              "Value #E": 8
            },
            "renameByName": {
              "Value #A": "latitude",
              "Value #B": "longitude",
              "Value #C": "altitude_ft",
              "Value #D": "speed_kt",
              "Value #E": "track",
              "aircraft_type": "type"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Flights tracked",
      "description": "",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 14,
        "w": 9,
        "x": 15,
