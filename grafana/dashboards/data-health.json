      "fieldConfig": {
        "defaults": {
          "unit": "rps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "upper bound"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "lower bound"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
