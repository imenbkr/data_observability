# Copy to .env and adjust. .env is git-ignored.

# Where metrics go: "local" (Prometheus + Grafana in Docker) or "cloud" (Grafana Cloud via Alloy)
COMPOSE_PROFILES=local

# Grafana Cloud (only for COMPOSE_PROFILES=cloud), from your stack's Prometheus → Details page
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=1234567
# Access policy token with metrics:write, rules:read, rules:write
GRAFANA_CLOUD_API_TOKEN=

# AeroDataBox (RapidAPI, free "Basic" plan) for scheduled arrivals -> arrival delays. Optional.
RAPIDAPI_KEY=
SCHEDULE_AIRPORTS=DTTA,DTNH,DTMB

POLL_SECONDS=60
# adsb.lol asks for a descriptive User-Agent; put your project URL or contact here
USER_AGENT=tunisia-flights-data-observability-demo (+https://github.com/imenbkr/data_observability)
