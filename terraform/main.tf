# Provisions the dashboard on a Grafana instance (Grafana Cloud or self-hosted) as code.
#
#   export TF_VAR_grafana_url=https://<stack>.grafana.net
#   export TF_VAR_grafana_token=<service account token, Editor role>
#   terraform init && terraform apply

terraform {
  required_version = ">= 1.5"
  required_providers {
    grafana = {
      source  = "grafana/grafana"
      version = "~> 4.53"
    }
  }
}

variable "grafana_url" {
  description = "Grafana URL, e.g. https://demoo11y.grafana.net"
  type        = string
}

variable "grafana_token" {
  description = "Grafana service account token with the Editor role"
  type        = string
  sensitive   = true
}

variable "prometheus_uid" {
  description = "UID of the Prometheus data source the notebook queries"
  type        = string
  default     = "grafanacloud-prom"
}

variable "enable_notebook" {
  description = "Deploy the notebook (needs the dashboard.notebooks feature on the Grafana instance)"
  type        = bool
  default     = false
}

provider "grafana" {
  url  = var.grafana_url
  auth = var.grafana_token
}

resource "grafana_folder" "data_observability" {
  title = "Data Observability"
}

# The JSON is generated by scripts/build_dashboard.py; Terraform only deploys it
resource "grafana_dashboard" "tunisia_flights" {
  folder      = grafana_folder.data_observability.uid
  config_json = file("${path.module}/../grafana/dashboards/tunisia-flights.json")
  overwrite   = true
}

# Notebook "Detect data volume drops", generated by scripts/build_notebook.py.
# Notebooks have no typed resource yet, so the generic App Platform resource deploys the manifest.
resource "grafana_apps_generic_resource" "volume_drops_notebook" {
  count = var.enable_notebook ? 1 : 0
  manifest = jsondecode(replace(
    file("${path.module}/../grafana/notebooks/detect-data-volume-drops.json"),
    "__DATASOURCE_UID__", var.prometheus_uid,
  ))
  allow_ui_updates = true
}

output "notebook_url" {
  value = var.enable_notebook ? "${var.grafana_url}/notebooks/detect-data-volume-drops" : null
}

output "dashboard_url" {
  value = grafana_dashboard.tunisia_flights.url
}
