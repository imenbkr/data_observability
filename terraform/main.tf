# Provisions the dashboard on a Grafana instance (Grafana Cloud or self-hosted) as code.
#
#   export TF_VAR_grafana_url=https://<stack>.grafana.net
#   export TF_VAR_grafana_token=<service account token, Editor role>
#   terraform init && terraform apply

terraform {
  required_version = ">= 1.5"
  required_providers {
    grafana = {
      source  = "grafana/grafana"
      version = "~> 4.53"
    }
  }
}

variable "grafana_url" {
  description = "Grafana URL, e.g. https://<stack>.grafana.net"
  type        = string
}

variable "grafana_token" {
  description = "Grafana service account token with the Editor role"
  type        = string
  sensitive   = true
}

variable "prometheus_uid" {
  description = "UID of the Prometheus data source the notebook queries"
  type        = string
  default     = "grafanacloud-prom"
}

variable "enable_notebook" {
  description = "Deploy the notebook (needs the dashboard.notebooks feature on the Grafana instance)"
  type        = bool
  default     = false
}

provider "grafana" {
  url  = var.grafana_url
  auth = var.grafana_token
}

resource "grafana_folder" "data_observability" {
  title = "Data Observability"
}

# The JSON is generated by scripts/build_dashboard.py; Terraform only deploys it.
# Public (externally shared) dashboards don't resolve the ${datasource} variable, so pin the real UID.
resource "grafana_dashboard" "tunisia_flights" {
  folder      = grafana_folder.data_observability.uid
  config_json = replace(file("${path.module}/../grafana/dashboards/tunisia-flights.json"), "$${datasource}", var.prometheus_uid)
  overwrite   = true
}

# Forecasting: the volume-drop notebook as a regular dashboard, for stacks without notebooks.
# Generated by scripts/build_forecast_dashboard.py from grafana/notebooks/detect-data-volume-drops.json
resource "grafana_folder" "forecasting" {
  title = "Forecasting"
}

resource "grafana_dashboard" "volume_forecasting" {
  folder      = grafana_folder.forecasting.uid
  config_json = replace(file("${path.module}/../grafana/dashboards/volume-forecasting.json"), "$${datasource}", var.prometheus_uid)
  overwrite   = true
}

output "forecasting_dashboard_url" {
  value = grafana_dashboard.volume_forecasting.url
}

# Notebook "Detect data volume drops", generated by scripts/build_notebook.py.
# Notebooks have no typed resource yet, so the generic App Platform resource deploys the manifest.
resource "grafana_apps_generic_resource" "volume_drops_notebook" {
  count = var.enable_notebook ? 1 : 0
  manifest = jsondecode(replace(replace(
    file("${path.module}/../grafana/notebooks/detect-data-volume-drops.json"),
    "__DATASOURCE_UID__", var.prometheus_uid),
    "__ML_DATASOURCE_UID__", "grafanacloud-ml-metrics",
  ))
  allow_ui_updates = true
}

# Grafana Cloud Machine Learning: forecast of the hourly flight-position count.
# Results are written to the grafanacloud-ml-metrics data source as
# tunisia_flight_positions:predicted{ml_forecast="yhat|yhat_lower|yhat_upper"} and :actual.
resource "grafana_machine_learning_job" "flight_positions_forecast" {
  name            = "Tunisia flight positions per hour"
  description     = "Forecast of valid flight positions per hour; learns daily and weekly seasonality"
  metric          = "tunisia_flight_positions"
  datasource_type = "prometheus"
  datasource_uid  = var.prometheus_uid
  query_params    = { expr = "flights:positions:count1h" }
  interval        = 120     # seconds between training points; the model needs 100+ points (~3.5 h)
  training_window = 2592000 # 30 days (90 days at 2-minute points exceeds the sample limit)
}

resource "grafana_machine_learning_alert" "flight_positions_drop" {
  job_id            = grafana_machine_learning_job.flight_positions_forecast.id
  title             = "Flight positions below ML forecast"
  anomaly_condition = "low"
  for               = "15m"
  labels            = { pillar = "volume", team = "data-engineering" }
  annotations       = { summary = "Hourly flight positions are below the Grafana ML forecast interval" }
}

# Use case: forecast hourly arrivals per Tunisian airport (one series per airport)
resource "grafana_machine_learning_job" "airport_arrivals_forecast" {
  name            = "Arrivals per Tunisian airport per hour"
  description     = "Forecast of hourly landings per Tunisian airport; learns the daily and weekly flight schedule"
  metric          = "tunisia_airport_arrivals"
  datasource_type = "prometheus"
  datasource_uid  = var.prometheus_uid
  query_params    = { expr = "sum by (airport) (increase(airport_arrivals_total[1h]))" }
  interval        = 300
  training_window = 2592000 # 30 days
}

output "notebook_url" {
  value = var.enable_notebook ? "${var.grafana_url}/notebooks/detect-data-volume-drops" : null
}

output "dashboard_url" {
  value = grafana_dashboard.tunisia_flights.url
}
